{
  "name": "react-library-template",
  "homepage": "https://morewings.github.io/react-library-template/",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "keywords": [
    "react",
    "template",
    "react-testing-library",
    "testing-library",
    "eslint",
    "npm",
    "rollup",
    "stylelint",
    "library",
    "package",
    "vite",
    "css-modules",
    "typescript"
  ],
  "description": "Missing React, typescript NPM library creation template",
  "scripts": {
    "dev": "vite",
    "clean:lib": "rm -rf dist",
    "build:lib": "vite build",
    "build": "run-s clean:lib build:lib",
    "lint:code": "eslint src/** --report-unused-disable-directives",
    "fix:code": "run-s 'lint:code --fix'",
    "lint:types": "tsc --pretty --noEmit",
    "lint:style": "stylelint ./src/**/*.css",
    "fix:style": "run-s 'lint:style --fix'",
    "test": "vitest --config=vitest.browser.config.ts",
    "preview": "vite preview",
    "start:docs": "storybook dev -p 6006",
    "build:docs": "storybook build",
    "prepare": "is-ci || husky",
    "lint-staged": "lint-staged"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-links": "10.6.2",
    "@storybook/builder-vite": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/lodash": "4.17.24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/browser-preview": "5.0.5",
    "@yelo/rollup-node-external": "1.0.1",
    "alias-kitchen": "0.2.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-ssr-friendly": "1.3.0",
    "eslint-plugin-storybook": "10.6.2",
    "eslint-plugin-tailwindcss": "3.18.2",
    "generate-react-cli": "8.4.9",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "is-ci": "4.1.0",
    "lint-staged": "17.6.0",
    "npm-run-all2": "8.0.4",
    "postcss": "8.5.30",
    "postcss-preset-env": "11.6.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-docgen-typescript": "2.4.0",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "39.0.1",
    "stylelint-order": "7.0.1",
    "stylelint-prettier": "5.0.3",
    "tailwindcss": "3.4.19",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  }
}
